DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me

ALLOWED_HOSTS=example.com,www.example.com,.liara.run
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,https://*.liara.run
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_SECURE_PROXY_SSL_HEADER=True
USE_X_FORWARDED_HOST=True

ADMIN_URL=secure-admin/
ADMIN_IP_ALLOWLIST=

DATABASE_URL=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dbN
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

STATIC_ROOT=/app/staticfiles
# On Liara mount a persistent disk and point MEDIA_ROOT to that mount path.
MEDIA_ROOT=/mnt/media

LOG_DIR=/app/logs
DJANGO_LOG_LEVEL=INFO

ENABLE_DJANGO_Q=True
SMS_TASK_BACKEND=django_q
Q_CLUSTER_WORKERS=2
Q_CLUSTER_TIMEOUT=90
Q_CLUSTER_RETRY=120
Q_CLUSTER_QUEUE_LIMIT=50
Q_CLUSTER_BULK=10

SMS_BACKEND=smsir
SMSIR_API_KEY=
SMSIR_BASE_URL=https://api.sms.ir/v1
SMSIR_LINE_NUMBER=
SMSIR_TEMPLATE_ID=
SMSIR_VERIFY_PARAMETER_NAME=Code
SMSIR_TIMEOUT_SECONDS=15
